// Plot each input dataset and the final classified map
//Map.addLayer(classificationMap_masked.select('TCC_avg'), utils.visParams('lai'), 'LAI');
//Map.addLayer(classificationMap_masked.select('TCC_avg'), utils.visParams('tcc'), 'TCC');
//Map.addLayer(classificationMap_masked.select('LST_avg'), utils.visParams('lst'), 'LST');
//Map.addLayer(classificationMap_masked.select('NDSI_max'), utils.visParams('snow_mask'), 'Snow Mask');
//Map.addLayer(classificationMap_masked.select('SWE_avg'), utils.visParams('swe'), 'SWE');
Map.addLayer(classificationMap_masked.select('Sensor_Classification'), utils.visParams('classes'), 'Classes');
//Map.setCenter(-70,55,4.5); // Quebec

// Plot the moutnain mask or water mask for context
//Map.addLayer(this_mountain_mask, utils.visParams('mountains'), 'Mountains');
//Map.addLayer(this_water_mask, utils.visParams('water_mask'), 'Water Mask');
//Map.addLayer(this_snow_mask, utils.visParams('snow_mask'), 'Snow Mask');

// Plot original inputs for context (clipped to ROI but not resampled to common spatial resolution)
//Map.addLayer(lai.lai(startDate, endDate, month, roi, false), utils.visParams('tcc'), 'input LAI');
//Map.addLayer(tcc.tcc(roi, false), utils.visParams('tcc'), 'input TCC');
//Map.addLayer(lst.lst(startDate, endDate, month, roi, false), utils.visParams('lst'), 'input LST');
//Map.addLayer(snow_mask.snow_mask(startDate, endDate, month, roi, false), utils.visParams('snow_mask'), 'input Snow Mask');
//Map.addLayer(globsnow_swe.swe(roi, month, false), utils.visParams('swe'), 'input SWE');



/////////////////// Export a map ///////////////////
// Export the image
 Export.image.toDrive({
   image: classificationMap_masked.toFloat(), // convert all layers to float values, this should preserve nan values that are masked out
   description: "quebec_ssum_" + swe + "_" + upperbound_SWE + "_" + trees + "_"  + lowerbound_trees + "-" + upperbound_trees, // filename
   folder: 'ssum_output', // name of the folder to save these into
   scale: 25000, // 25 km 
   region: roi, // roi geometry
   //skipEmptyTiles: true,
   fileFormat: 'GeoTIFF'
   //formatOptions: {
   //  cloudOptimized: true
   //},
   //maxPixels: 1e9
    });
