var utils = require('users/spestana/ssum:function_modules/utils'); // shared functions
var masks = require('users/spestana/ssum:function_modules/masks'); // functions that give us mountain, water body masks


// Land Surface Temperature (LST)
exports.lst = function(startDate, endDate, month, roi, reproject) {
  // Load MODIS Aqua Daily Land Surface Temperature 
  var modis = ee.ImageCollection('MODIS/006/MYD11A2').filterDate(startDate, endDate).select("LST_Day_1km");

  // Convert modis LST image collection to Celsius 
  var modisLST = modis.map(utils.modisLST);
  
  // Make a list of months
  var months = ee.List.sequence(1,12);
  // Calculate mean for each pixel, aggregating by month 
  var modisLSTmonth = ee.ImageCollection.fromImages(
   months.map(function(m) {
      return modisLST.filter(ee.Filter.calendarRange(m,m, 'month'))
      .mean()
      .rename('LST_avg')
      .set('month', m);
    }));
  //print('MODIS LST ImageCollection:', modisLSTmonth);

  // Make a list of monthly composites and select a month
  var modisList = modisLSTmonth.toList(modisLSTmonth.size());
  var LSTmonth = ee.Image(modisList.get(month)).select('LST_avg');

  // mask out water bodies
  //var LSTmonth_masked = LSTmonth.mask(masks.water_mask(roi));

  // Create a modis LST image collection at common resolution
  // default reproject to true
  if (reproject === undefined){var reproject = true}
  // if reproject = true, then reproject before clipping
  if (reproject) {
    var LSTmonth_reprojected = utils.common_reproject(LSTmonth);
  }
  else {
    var LSTmonth_reprojected = LSTmonth;
  }
  

  // clip to ROI
  var LSTmonth_roi = LSTmonth_reprojected.clip(roi);

  // return LST
  return LSTmonth_roi;
};

